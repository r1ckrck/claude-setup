# capture skills — environment overrides (video-ingest, carousel-ingest)
#
# The ingest scripts read these from the environment and fall back to the
# ~/ defaults shown below. Paths support ~ and are expanded at runtime.
# Copy to .env (gitignored) or export in your shell; leave unset to use defaults.

# Directory where the ingested markdown summary is written.
INGEST_INBOX=~/inbox-remote

# Scratch root for downloads and per-run work dirs.
# cleanup only removes work dirs that live under this root.
INGEST_TMPROOT=~/.cache/ingest

# Path to the whisperx binary (video-ingest audio transcription).
WHISPERX_BIN=~/.local/bin/whisperx
